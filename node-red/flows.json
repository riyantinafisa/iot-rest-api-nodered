      ]
    ],
    "name": "Build Response History",
    "func": "const rows = Array.isArray(msg.payload) ? msg.payload : [];\nmsg.statusCode = 200;\nmsg.payload = {status: 'success', count: rows.length, source: 'sqlite', data: rows};\nmsg.headers = {'Access-Control-Allow-Origin': '*'};\nreturn msg;",
    "outputs": 1,
