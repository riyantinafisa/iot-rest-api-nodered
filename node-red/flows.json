    "name": "Auth + Response Threshold",
    "func": "// --- Autentikasi API Key (header X-API-Key) ---\nconst API_KEY = env.get('API_KEY') || 'iot-kampus-2026';\nif (msg.req.headers['x-api-key'] !== API_KEY) {\n    msg.statusCode = 401;\n    msg.payload = {status: 'error', message: 'API key tidak valid atau tidak ada (header X-API-Key)'};\n    msg.headers = {'Access-Control-Allow-Origin': '*'};\n    return msg;\n}\nconst t = flow.get('threshold');\nmsg.statusCode = 200;\nmsg.payload = {status: 'success', suhu_max: (typeof t === 'number') ? t : 30};\nmsg.headers = {'Access-Control-Allow-Origin': '*'};\nreturn msg;",
