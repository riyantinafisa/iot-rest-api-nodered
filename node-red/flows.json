  {
    "id": "thr_put",
    "type": "function",
    "z": "flow_api",
    "x": 430,
    "y": 730,
    "wires": [
      [
        "http_resp_thr_put"
      ],
      [
        "ws_out"
      ]
    ],
    "name": "Auth + Set Threshold",
    "func": "// --- Autentikasi API Key (header X-API-Key) ---\nconst API_KEY = env.get('API_KEY') || 'iot-kampus-2026';\nif (msg.req.headers['x-api-key'] !== API_KEY) {\n    msg.statusCode = 401;\n    msg.payload = {status: 'error', message: 'API key tidak valid atau tidak ada (header X-API-Key)'};\n    msg.headers = {'Access-Control-Allow-Origin': '*'};\n    return [msg, null];\n}\nconst raw = msg.payload ? msg.payload.suhu_max : undefined;\nconst v = Number(raw);\nif (raw === undefined || raw === null || raw === '' || !isFinite(v) || v < -50 || v > 150) {\n    msg.statusCode = 400;\n    msg.payload = {status: 'error', message: 'suhu_max wajib angka antara -50 dan 150'};\n    msg.headers = {'Access-Control-Allow-Origin': '*'};\n    return [msg, null];\n}\nflow.set('threshold', v);\nflow.set('lastAlertTime', 0);    // reset cooldown agar batas baru langsung berlaku\n\nconst wsMsg = {payload: {type: 'threshold', suhu_max: v}};\nmsg.statusCode = 200;\nmsg.payload = {status: 'success', message: 'Batas suhu diperbarui', suhu_max: v};\nmsg.headers = {'Access-Control-Allow-Origin': '*'};\nreturn [msg, wsMsg];",
    "outputs": 2,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": []
  },
