  {
    "id": "proc_kontrol",
    "type": "function",
    "z": "flow_api",
    "x": 430,
    "y": 540,
    "wires": [
      [
        "http_resp_kontrol"
      ],
      [
        "mqtt_publish_kontrol"
      ],
      [
        "ws_out"
      ]
    ],
    "name": "Auth + Validasi + Publish",
    "func": "// --- Autentikasi API Key (header X-API-Key) ---\nconst API_KEY = env.get('API_KEY') || 'iot-kampus-2026';\nif (msg.req.headers['x-api-key'] !== API_KEY) {\n    msg.statusCode = 401;\n    msg.payload = {status: 'error', message: 'API key tidak valid atau tidak ada (header X-API-Key)'};\n    msg.headers = {'Access-Control-Allow-Origin': '*'};\n    return [msg, null, null];\n}\nconst body = msg.payload || {};\nlet device = body.device, action = body.action;\n// Kompatibel dengan format materi kuliah: {\"perintah\": \"ON\"}\nif (!action && body.perintah) { device = device || 'lamp'; action = String(body.perintah); }\nif (!device || !action) {\n    msg.statusCode = 400;\n    msg.payload = {status: 'error', message: 'device dan action wajib diisi'};\n    msg.headers = {'Access-Control-Allow-Origin': '*'};\n    return [msg, null, null];\n}\naction = String(action).toLowerCase();\nif (action !== 'on' && action !== 'off') {\n    msg.statusCode = 400;\n    msg.payload = {status: 'error', message: 'action harus on atau off'};\n    msg.headers = {'Access-Control-Allow-Origin': '*'};\n    return [msg, null, null];\n}\nconst cmd = {device: device, action: action};\nif (device === 'lamp') flow.set('lampStatus', action.toUpperCase());\n\nconst mqttMsg = {topic: 'iot/kontrol', payload: cmd};\nconst wsMsg = {payload: {type: 'lamp', device: device, status: action.toUpperCase()}};\n\nmsg.statusCode = 200;\nmsg.payload = {status: 'success', message: 'Perintah terkirim', sent: cmd};\nmsg.headers = {'Access-Control-Allow-Origin': '*'};\nreturn [msg, mqttMsg, wsMsg];",
    "outputs": 3,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": []
  },
