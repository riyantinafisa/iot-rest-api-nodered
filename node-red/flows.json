  {
    "id": "proc_sensor",
    "type": "function",
    "z": "flow_api",
    "x": 410,
    "y": 120,
    "wires": [
      [
        "sqlite_insert",
        "debug_sensor"
      ],
      [
        "ws_out"
      ],
      [
        "mqtt_alert_out",
        "ws_out",
        "debug_alert"
      ]
    ],
    "name": "Proses Data Sensor",
    "func": "// Dipanggil tiap ada data sensor dari MQTT (iot/sensor)\nconst d = msg.payload;\nif (typeof d !== 'object' || d === null || typeof d.suhu !== 'number') {\n    node.warn('Payload sensor tidak valid');\n    return null;\n}\nd.received = new Date().toISOString();\nflow.set('lastSensor', d);   // data terakhir (cepat, di memori)\n\n// Output 1 -> SQLite (history permanen)\nconst dbMsg = { params: {\n    $suhu: d.suhu, $kelembaban: d.kelembaban,\n    $timestamp: d.timestamp || null, $received: d.received\n}};\n\n// Output 2 -> WebSocket (push ke dashboard, tanpa polling)\nconst wsMsg = { payload: { type: 'sensor', data: d, status_lampu: flow.get('lampStatus') || 'UNKNOWN' } };\n\n// Output 3 -> Notifikasi bila suhu melewati batas\nlet alertMsg = null;\nconst t = flow.get('threshold');\nconst batas = (typeof t === 'number') ? t : 30;\nif (d.suhu > batas) {\n    const now = Date.now();\n    const last = flow.get('lastAlertTime') || 0;\n    if (now - last > 60000) {            // cooldown 60 detik agar tidak spam\n        flow.set('lastAlertTime', now);\n        const alert = {\n            type: 'alert',\n            message: 'Suhu ' + d.suhu + '°C melewati batas ' + batas + '°C',\n            suhu: d.suhu, threshold: batas, time: d.received\n        };\n        flow.set('lastAlert', alert);\n        alertMsg = { topic: 'iot/alert', payload: alert };\n    }\n} else {\n    flow.set('lastAlertTime', 0);\n}\nreturn [dbMsg, wsMsg, alertMsg];",
    "outputs": 3,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": []
  },
