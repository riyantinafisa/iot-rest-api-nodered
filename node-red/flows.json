    "id": "http_get_suhu",
    "type": "http in",
    "z": "flow_api",
    "x": 170,
    "y": 330,
    "wires": [
      [
        "resp_suhu"
      ]
    ],
    "name": "GET /api/suhu",
    "url": "/api/suhu",
    "method": "get",
    "upload": false,
    "swaggerDoc": ""
  },
  {
    "id": "resp_suhu",
    "type": "function",
    "z": "flow_api",
    "x": 420,
    "y": 330,
    "wires": [
      [
        "http_resp_suhu"
      ]
    ],
    "name": "Auth + Response Suhu",
    "func": "// --- Autentikasi API Key (header X-API-Key) ---\nconst API_KEY = env.get('API_KEY') || 'iot-kampus-2026';\nif (msg.req.headers['x-api-key'] !== API_KEY) {\n    msg.statusCode = 401;\n    msg.payload = {status: 'error', message: 'API key tidak valid atau tidak ada (header X-API-Key)'};\n    msg.headers = {'Access-Control-Allow-Origin': '*'};\n    return msg;\n}\nconst data = flow.get('lastSensor') || {suhu: null, kelembaban: null, timestamp: null};\nconst t = flow.get('threshold');\nmsg.statusCode = 200;\nmsg.payload = {\n    status: 'success',\n    data: data,\n    status_lampu: flow.get('lampStatus') || 'UNKNOWN',\n    threshold: (typeof t === 'number') ? t : 30,\n    server_time: new Date().toISOString()\n};\nmsg.headers = {'Access-Control-Allow-Origin': '*'};\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": []
