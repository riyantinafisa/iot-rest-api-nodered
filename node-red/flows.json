  {
    "id": "hist_prep",
    "type": "function",
    "z": "flow_api",
    "x": 420,
    "y": 410,
    "wires": [
      [
        "http_resp_history"
      ],
      [
        "sqlite_select"
      ]
    ],
    "name": "Auth + Siapkan Query",
    "func": "// --- Autentikasi API Key (header X-API-Key) ---\nconst API_KEY = env.get('API_KEY') || 'iot-kampus-2026';\nif (msg.req.headers['x-api-key'] !== API_KEY) {\n    msg.statusCode = 401;\n    msg.payload = {status: 'error', message: 'API key tidak valid atau tidak ada (header X-API-Key)'};\n    msg.headers = {'Access-Control-Allow-Origin': '*'};\n    return [msg, null];\n}\nlet n = parseInt(msg.req.query.limit, 10);\nif (isNaN(n) || n < 1) n = 50;\nif (n > 500) n = 500;\nmsg.params = {$limit: n};\nreturn [null, msg];",
    "outputs": 2,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": []
  },
  {
    "id": "sqlite_select",
    "type": "sqlite",
    "z": "flow_api",
    "x": 650,
    "y": 440,
    "wires": [
      [
        "hist_resp"
      ]
    ],
    "name": "Baca History",
    "mydb": "sqlite_db",
    "sqlquery": "prepared",
    "mode": "readwrite",
    "sql": "SELECT id, suhu, kelembaban, timestamp, received FROM (SELECT * FROM sensor_history ORDER BY id DESC LIMIT $limit) ORDER BY id ASC;"
