  {
    "id": "mqtt_sensor_in",
    "type": "mqtt in",
    "z": "flow_api",
    "x": 170,
    "y": 120,
    "wires": [
      [
        "proc_sensor"
      ]
    ],
    "name": "Subscribe Sensor",
    "topic": "iot/sensor",
    "qos": "0",
    "datatype": "json",
    "broker": "mqtt_broker_config",
    "nl": false,
    "rap": true,
    "rh": 0,
    "inputs": 0
